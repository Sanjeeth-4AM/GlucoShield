# ==============================================================================
# GLUCOSHIELD PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env in production deployment environments.
# DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Profile
# ------------------------------------------------------------------------------
# Must be PRODUCTION for hardened deployment.
APP_ENV=PRODUCTION
DEBUG=false

# ------------------------------------------------------------------------------
# 2. Database Configuration (Production PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://glucoshield_app:CHANGE_THIS_TO_STRONG_PASSWORD@localhost:5432/glucoshield_prod

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Security
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32 (MUST BE AT LEAST 32 CHARACTERS)
JWT_SECRET_KEY=REPLACE_WITH_MINIMUM_32_CHAR_CRYPTOGRAPHICALLY_SECURE_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins (DO NOT USE WILDCARD IN PRODUCTION)
# ------------------------------------------------------------------------------
CORS_ORIGINS=https://glucoshield.hospital.org,https://app.glucoshield.org

# ------------------------------------------------------------------------------
# 5. Model Version Selection
# ------------------------------------------------------------------------------
# Options: V1_FROZEN (default safe production baseline)
#          PHASE13_VALIDATED (disagreement-gated context-aware model)
ACTIVE_MODEL_VERSION=V1_FROZEN
GLUCOSHIELD_DEV_MODE=false

# ------------------------------------------------------------------------------
# 6. Rate Limiting & Abuse Controls
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_RPM=120
RATE_LIMIT_INFERENCE_RPM=30
MAX_REQUEST_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 7. Resource & Concurrency Management
# ------------------------------------------------------------------------------
MAX_CONCURRENT_INFERENCES=4

# ------------------------------------------------------------------------------
# 8. External Integrations (Optional)
# ------------------------------------------------------------------------------
USDA_API_KEY=
HUGGINGFACE_API_TOKEN=
DEFAULT_NUTRITION_PROVIDER=usda
DEFAULT_RECOGNITION_PROVIDER=huggingface
