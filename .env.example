# ==============================================================================
# GLUCOSHIELD FOOD VISION & NUTRITION API CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your keys if available.
# The system runs safely using DEMO_KEY or mock providers if keys are omitted.

# USDA FoodData Central API Key (Free registration at https://api.data.gov/signup/)
# Default: DEMO_KEY (supports 30 requests/hour)
USDA_API_KEY=DEMO_KEY

# Hugging Face User Access Token (Free at https://huggingface.co/settings/tokens)
# Optional: Used for serverless food classification inference API
HUGGINGFACE_API_TOKEN=

# Provider Selection Preferences ('usda', 'openfoodfacts', 'mock')
DEFAULT_NUTRITION_PROVIDER=usda

# Recognition Provider Preferences ('huggingface', 'mock')
DEFAULT_RECOGNITION_PROVIDER=huggingface
