# ==============================================================================
# GLUCOSHIELD PRODUCTION CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL Production / SQLite Local Fallback)
# ------------------------------------------------------------------------------
# For local development with SQLite fallback:
DATABASE_URL=sqlite:///./glucoshield.db

# For production PostgreSQL:
# DATABASE_URL=postgresql://glucoshield_user:your_secure_password@localhost:5432/glucoshield_db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ------------------------------------------------------------------------------
# 2. Authentication & JWT Security
# ------------------------------------------------------------------------------
# Generate a secure 256-bit random key: openssl rand -hex 32
# Required length >= 32 characters
JWT_SECRET_KEY=change_this_to_a_secure_256bit_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. CORS Allowed Origins
# ------------------------------------------------------------------------------
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 4. External Nutrition & Food Vision Providers
# ------------------------------------------------------------------------------
# USDA FoodData Central API Key (Free registration at https://api.data.gov/signup/)
USDA_API_KEY=DEMO_KEY

# Hugging Face User Access Token (Free at https://huggingface.co/settings/tokens)
HUGGINGFACE_API_TOKEN=

# Provider Preferences
DEFAULT_NUTRITION_PROVIDER=usda
DEFAULT_RECOGNITION_PROVIDER=huggingface
